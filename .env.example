# =============================================================================
# Copy this file to `.env` and fill in real values. Do not commit `.env`.
# Single reference for environment variables used by this app (work_logs).
# =============================================================================

# --- Product / site identity ---
# Shown in titles, emails, and UI (templates use {{ app_name }}).
APP_NAME=work_logs

# Public site hostname (legal footers, default email addresses, canonical URLs).
DOMAIN_NAME=logs.brakesystems.ca

# Bump when you change static CSS/JS so browsers pick up new assets.
ASSETS_VERSION=6

# --- work_logs–specific ---
# Pending team invite link lifetime in days (1–90). See `invites.py`.
TENANT_INVITE_EXPIRES_DAYS=7

# Optional: cap total user rows across all tenants (empty = no cap).
# MAX_REGISTERED_USERS=

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=False
FLASK_ENV=development
HOST=0.0.0.0
PORT=5099

# --- PostgreSQL (`database.py`, `setup_database.py`) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=work_logs_db
DB_USER=work_logs_user
DB_PASSWORD=change-me
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# --- Seeded site admin (`setup_database.py`) ---
# First-run only: creates a user on the default tenant with `is_site_admin` for `/admin`.
ADMIN_USERNAME_IN_DB=admin
ADMIN_EMAIL_IN_DB=
ADMIN_PASSWORD_IN_DB=

# --- Outbound email (`email_service.py`: Mailgun → SendGrid → SMTP) ---
# Mailgun (typical for this project). EU accounts need region or API base.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_REGION=eu
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# SENDGRID_API_KEY=

# SMTP fallback (e.g. Brevo): set MAIL_SERVER + MAIL_USERNAME + MAIL_PASSWORD
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=

# From address for transactional mail (verification, invites, password reset).
NO_REPLY=noreply@example.com

# --- Registration / auth UX ---
# reCAPTCHA v2 on register/forgot-password (optional if keys unset—see `routes.py`).
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Optional: notify this inbox when a user verifies email (`routes.py`).
# REGISTRATION_EMAIL=

# --- Rate limiting (`security.py`) ---
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# --- Stripe webhook stub (`routes.py`; optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
